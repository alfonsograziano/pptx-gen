node_modules/
tmp/
templates-preview/

# The example workspace's engine link, recreated by `npm run example`.
examples/workspace/node_modules/

# Generated deck artifacts: rendered screenshots (PNGs) and PDF previews.
# The .pptx in output/ is kept; only the heavy render artifacts are ignored.
examples/workspace/projects/*/output/screenshots/
examples/workspace/projects/*/output/**/*.pdf

# Example authoring artifacts.
examples/screenshots/
examples/**/*.pdf

# Rendered figure artifacts. The authored HTML in <deck>/figures/ is source and
# is kept; output/figures/ holds the PNG plus a generated copy of the HTML, and
# is rebuilt on every build. The figure example commits its PNG so the repo is
# browsable on a machine with no browser installed.
projects/*/output/figures/
examples/**/output/figures/
!examples/workspace/projects/figure-mockup/output/figures/

# Intermediate PDFs left next to any rendered screenshots.
**/screenshots/*.pdf
